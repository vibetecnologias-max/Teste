rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // PROFESSIONALS COLLECTION
    match /professionals/{profId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // CLINICS & ROOMS
    match /clinics/{clinicId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /clinic_rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // PATIENTS (Administrative Data)
    match /patients/{patientId} {
      allow get: if isSignedIn() && (
        resource.data.psychologistId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.psychologistId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.psychologistId == request.auth.uid);
    }

    // APPOINTMENTS
    match /appointments/{appId} {
      allow get: if isSignedIn() && (
        resource.data.psychologistId == request.auth.uid ||
        resource.data.patientId == request.auth.uid ||
        resource.data.patientUserId == request.auth.uid ||
        isSuperAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.psychologistId == request.auth.uid ||
        resource.data.patientId == request.auth.uid ||
        resource.data.patientUserId == request.auth.uid ||
        isSuperAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.psychologistId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    // CLINICAL RECORDS (STRICT SIGILO PROFISSIONAL / CFP / LGPD)
    // Only the authorized psychologist can read/write clinical evolutions and private notes.
    // Patients and clinic managers are strictly denied access.
    match /clinical_records/{recordId} {
      allow get: if isSignedIn() && (resource.data.psychologistId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (
        resource.data.psychologistId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.psychologistId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.psychologistId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.psychologistId == request.auth.uid;
    }

    // FINANCIAL: PAYMENTS & EXPENSES
    match /payments/{paymentId} {
      allow get: if isSignedIn() && (
        resource.data.psychologistId == request.auth.uid ||
        resource.data.patientId == request.auth.uid ||
        isSuperAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.psychologistId == request.auth.uid ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (
        resource.data.psychologistId == request.auth.uid ||
        isSuperAdmin()
      );
      allow write: if isSignedIn() && (
        request.resource.data.psychologistId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    // SUBSCRIPTIONS & PLANS
    match /subscriptions/{subId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{notifId} {
      allow get: if isSignedIn() && resource.data.recipientUserId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.recipientUserId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.recipientUserId == request.auth.uid;
    }

    // AUDIT LOGS (Immutable security audit trail)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || isSignedIn();
      allow create: if isSignedIn();
      allow update: if false; // Immutable
      allow delete: if false; // Immutable
    }
  }
}
