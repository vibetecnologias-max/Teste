rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Active User Check: Block suspended users from accessing protected collections
    function isActiveUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().status == 'active';
    }

    // Role-specific authorization functions based strictly on real /users/{uid} document
    function isPsychologist() {
      return isActiveUser() && getUserData().role == 'psychologist';
    }

    function isClinicManager() {
      return isActiveUser() && getUserData().role == 'clinic_manager';
    }

    function isPatient() {
      return isActiveUser() && getUserData().role == 'patient';
    }

    // USERS COLLECTION
    // Anti-privilege-escalation & Controlled Administrative updates
    // Common users cannot change role, uid, clinicId, professionalId, status, permissions.
    // Allowed update fields for regular users: displayName, phone, avatarUrl, photoURL, updatedAt.
    // SuperAdmin updates are strictly controlled: uid is immutable.
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role != 'superadmin' &&
        (request.resource.data.role in ['psychologist', 'clinic_manager', 'patient']) &&
        request.resource.data.status == 'active';
      allow update: if isSignedIn() && isActiveUser() && (
        // Regular user self update: strictly limited to non-sensitive profile fields
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.status == resource.data.status &&
         (!('clinicId' in resource.data) || request.resource.data.clinicId == resource.data.clinicId) &&
         (!('professionalId' in resource.data) || request.resource.data.professionalId == resource.data.professionalId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'avatarUrl', 'photoURL', 'updatedAt'])) ||
        // Superadmin controlled administrative update: uid is immutable
        (isSuperAdmin() &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'clinicId', 'professionalId', 'displayName', 'phone', 'avatarUrl', 'photoURL', 'updatedAt']))
      );
      allow delete: if isSuperAdmin();
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      allow get, list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // PROFESSIONALS PRIVATE RECORD (Administrative & Personal Contact Data)
    // Protected: personal email, personal phone, billing details.
    // Creation restricted strictly to psychologists for their own profile.
    match /professionals/{profId} {
      allow get: if isSignedIn() && isActiveUser() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && isActiveUser() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isPsychologist() && request.resource.data.userId == request.auth.uid && request.resource.data.id == profId;
      allow update: if isSignedIn() && isActiveUser() && (
        // Psychologist updating own profile (cannot alter status/verification or core IDs)
        (isPsychologist() && resource.data.userId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.id == resource.data.id &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'bio', 'specialities', 'sessionDurationMinutes', 'sessionPrice', 'photoUrl', 'clinicIds', 'updatedAt'])) ||
        // Superadmin administrative verification/suspension
        (isSuperAdmin() &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.id == resource.data.id &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verificationDetails', 'name', 'crp', 'phone', 'bio', 'specialities', 'sessionDurationMinutes', 'sessionPrice', 'photoUrl', 'clinicIds', 'updatedAt']))
      );
      allow delete: if isSuperAdmin();
    }

    // PROFESSIONALS PUBLIC DIRECTORY (Public Clinical Practice Info)
    // Non-sensitive: name, crp, bio, specialities, duration, price, status.
    // Only registered psychologists with valid private profile can publish their public profile.
    // Initial status must be 'pending_verification'.
    match /professionals_public/{profId} {
      allow get, list: if isSignedIn() && isActiveUser();
      allow create: if isPsychologist() &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.id == profId &&
        request.resource.data.status == 'pending_verification' &&
        exists(/databases/$(database)/documents/professionals/$(profId)) &&
        get(/databases/$(database)/documents/professionals/$(profId)).data.userId == request.auth.uid;
      allow update: if isSignedIn() && isActiveUser() && (
        // Psychologist updating public info (cannot change status to active without superadmin)
        (isPsychologist() && request.auth.uid == resource.data.userId &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.id == resource.data.id &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'specialities', 'sessionDurationMinutes', 'sessionPrice', 'photoUrl', 'clinicIds', 'updatedAt'])) ||
        // Superadmin verifying or changing status
        (isSuperAdmin() &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.id == resource.data.id &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verificationDetails', 'name', 'crp', 'bio', 'specialities', 'sessionDurationMinutes', 'sessionPrice', 'photoUrl', 'clinicIds', 'updatedAt']))
      );
      allow delete: if isSuperAdmin();
    }

    // AVAILABILITY CONFIGS (Weekly working schedule and slot intervals)
    // Psychologist owns their availability; patients read to book open slots.
    match /availability_configs/{profId} {
      allow get, list: if isSignedIn() && isActiveUser();
      allow create, update: if isPsychologist() &&
        request.auth.uid == profId &&
        request.resource.data.psychologistId == request.auth.uid &&
        request.resource.data.weeklySchedule is list &&
        (request.resource.data.slotDurationMinutes in [30, 45, 50, 60, 90, 120]) &&
        (request.resource.data.bufferMinutes >= 0 && request.resource.data.bufferMinutes <= 60);
      allow delete: if false;
    }

    // CLINICS (Multi-tenant isolation & Property Protection)
    match /clinics/{clinicId} {
      allow get, list: if isSignedIn() && isActiveUser() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if (isClinicManager() || isSuperAdmin()) && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'active';
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isClinicManager() && resource.data.ownerId == request.auth.uid &&
         request.resource.data.ownerId == resource.data.ownerId &&
         request.resource.data.id == resource.data.id &&
         request.resource.data.status == resource.data.status &&
         (!('cnpj' in resource.data) || request.resource.data.cnpj == resource.data.cnpj) &&
         (!('roomsCount' in resource.data) || request.resource.data.roomsCount == resource.data.roomsCount) &&
         (!('professionalsCount' in resource.data) || request.resource.data.professionalsCount == resource.data.professionalsCount) &&
         (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'tradeName', 'phone', 'email', 'address', 'updatedAt']))
      );
      allow delete: if isSuperAdmin();
    }

    // CLINIC ROOMS
    // clinicId is immutable, only clinic owner or superadmin can modify
    match /clinic_rooms/{roomId} {
      allow get, list: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/clinics/$(resource.data.clinicId)) &&
         get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid)
      );
      allow create: if (isClinicManager() || isSuperAdmin()) && (
        exists(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)) &&
        get(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)).data.ownerId == request.auth.uid
      );
      allow update: if (isClinicManager() || isSuperAdmin()) && (
        exists(/databases/$(database)/documents/clinics/$(resource.data.clinicId)) &&
        get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid &&
        request.resource.data.clinicId == resource.data.clinicId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'color', 'capacity', 'active', 'updatedAt'])
      );
      allow delete: if (isClinicManager() || isSuperAdmin()) && (
        exists(/databases/$(database)/documents/clinics/$(resource.data.clinicId)) &&
        get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid
      );
    }

    // PATIENTS (Administrative Data)
    // Strictly limited to treating psychologist or the patient themselves.
    // Only psychologist can create patients in their caseload.
    match /patients/{patientId} {
      allow get, list: if isSignedIn() && isActiveUser() && (
        (isPsychologist() && resource.data.psychologistId == request.auth.uid) ||
        (isPatient() && resource.data.userId == request.auth.uid)
      );
      allow create: if isPsychologist() &&
        request.resource.data.psychologistId == request.auth.uid &&
        request.resource.data.id == patientId;
      allow update: if isSignedIn() && isActiveUser() && (
        // Psychologist update: cannot mutate psychologistId, id, or createdAt
        (isPsychologist() && resource.data.psychologistId == request.auth.uid &&
         request.resource.data.psychologistId == resource.data.psychologistId &&
         request.resource.data.id == resource.data.id &&
         (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)) ||
        // Patient update: cannot mutate psychologistId, clinicId, userId, or id
        (isPatient() && resource.data.userId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.psychologistId == resource.data.psychologistId &&
         request.resource.data.id == resource.data.id &&
         (!('clinicId' in resource.data) || request.resource.data.clinicId == resource.data.clinicId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'address', 'emergencyContact', 'birthDate', 'updatedAt']))
      );
      allow delete: if isPsychologist() && resource.data.psychologistId == request.auth.uid;
    }

    // APPOINTMENTS
    // - Psychologist and patient only access sessions they participate in.
    // - Creation requires legitimate relationship and verified active status:
    //   * Psychologist must specify existing patient belonging to their caseload.
    //   * Patient must specify verified active public psychologist and book as 'pending'.
    //   * Price and duration must match authorized values from professional profile.
    match /appointments/{appId} {
      allow get, list: if isSignedIn() && isActiveUser() && (
        (isPsychologist() && resource.data.psychologistId == request.auth.uid) ||
        (isPatient() && (resource.data.patientUserId == request.auth.uid || resource.data.patientId == request.auth.uid))
      );
      allow create: if isSignedIn() && isActiveUser() && (
        // Psychologist creating session: patient must exist and belong to this psychologist
        (isPsychologist() && request.resource.data.psychologistId == request.auth.uid &&
         exists(/databases/$(database)/documents/patients/$(request.resource.data.patientId)) &&
         get(/databases/$(database)/documents/patients/$(request.resource.data.patientId)).data.psychologistId == request.auth.uid &&
         (request.resource.data.status in ['confirmed', 'pending'])) ||
        // Patient requesting session: must be for themselves, pending status, active/verified psychologist
        (isPatient() && request.resource.data.patientUserId == request.auth.uid &&
         request.resource.data.requestedBy == 'patient' &&
         request.resource.data.status == 'pending' &&
         request.resource.data.paymentStatus == 'pending' &&
         exists(/databases/$(database)/documents/professionals_public/$(request.resource.data.psychologistId)) &&
         get(/databases/$(database)/documents/professionals_public/$(request.resource.data.psychologistId)).data.status == 'active' &&
         request.resource.data.price == get(/databases/$(database)/documents/professionals_public/$(request.resource.data.psychologistId)).data.sessionPrice &&
         request.resource.data.durationMinutes == get(/databases/$(database)/documents/professionals_public/$(request.resource.data.psychologistId)).data.sessionDurationMinutes &&
         request.resource.data.patientId is string && request.resource.data.patientId.size() > 0 &&
         exists(/databases/$(database)/documents/patients/$(request.resource.data.patientId)) &&
         get(/databases/$(database)/documents/patients/$(request.resource.data.patientId)).data.psychologistId == request.resource.data.psychologistId &&
         (get(/databases/$(database)/documents/patients/$(request.resource.data.patientId)).data.userId == request.auth.uid || get(/databases/$(database)/documents/patients/$(request.resource.data.patientId)).data.email == getUserData().email))
      );
      allow update: if isSignedIn() && isActiveUser() && (
        // Core relational and financial fields are IMMUTABLE:
        request.resource.data.psychologistId == resource.data.psychologistId &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.patientUserId == resource.data.patientUserId &&
        request.resource.data.clinicId == resource.data.clinicId &&
        request.resource.data.roomId == resource.data.roomId &&
        request.resource.data.requestedBy == resource.data.requestedBy &&
        request.resource.data.price == resource.data.price &&
        request.resource.data.patientName == resource.data.patientName &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.startTime == resource.data.startTime &&
        request.resource.data.endTime == resource.data.endTime &&
        request.resource.data.durationMinutes == resource.data.durationMinutes &&
        request.resource.data.createdAt == resource.data.createdAt && (
          // Case 1: Treating Psychologist update (status, notes, cancellationReason, paymentStatus, updatedAt)
          (isPsychologist() && resource.data.psychologistId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'cancellationReason', 'paymentStatus', 'updatedAt']) &&
           (resource.data.status == request.resource.data.status ||
            (resource.data.status == 'pending' && request.resource.data.status in ['confirmed', 'rejected', 'cancelled']) ||
            (resource.data.status == 'confirmed' && request.resource.data.status in ['completed', 'no_show', 'cancelled']) ||
            (resource.data.status == 'cancellation_requested' && request.resource.data.status in ['cancelled', 'confirmed']))) ||
          // Case 2: Participating Patient update (strictly cancellation and reason)
          (isPatient() && resource.data.patientUserId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancellationReason', 'notes', 'updatedAt']) &&
           (resource.data.status == request.resource.data.status ||
            (resource.data.status == 'pending' && request.resource.data.status == 'cancelled') ||
            (resource.data.status == 'confirmed' && request.resource.data.status in ['cancellation_requested', 'cancelled'])))
        )
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        (isPsychologist() && resource.data.psychologistId == request.auth.uid && resource.data.status in ['pending', 'cancelled', 'rejected']) ||
        (isPatient() && resource.data.patientUserId == request.auth.uid && resource.data.status == 'pending')
      );
    }

    // CLINICAL RECORDS (STRICT SIGILO PROFISSIONAL / CFP nº 01/2009 / LGPD Artigo 11)
    // STRICTEST RULE: Only the treating psychologist who owns the record can access it.
    // SuperAdmin, Clinic Managers, Receptionists and Patients are STRICTLY DENIED read and write.
    // Validates legitimate link: patient must exist and belong to this psychologist.
    // REAL IMMUTABILITY: original clinical record text is strictly IMMUTABLE once created.
    // Any rectification is registered as a separate immutable document in the subcollection.
    // Deletion is STRICTLY PROHIBITED (CFP 01/2009 Art. 12 mandatory 5-year retention).
    match /clinical_records/{recordId} {
      allow get, list: if isPsychologist() && resource.data.psychologistId == request.auth.uid;
      allow create: if isPsychologist() &&
        request.resource.data.psychologistId == request.auth.uid &&
        request.resource.data.patientId is string &&
        request.resource.data.patientId.size() > 0 &&
        exists(/databases/$(database)/documents/patients/$(request.resource.data.patientId)) &&
        get(/databases/$(database)/documents/patients/$(request.resource.data.patientId)).data.psychologistId == request.auth.uid;
      allow update: if false; // STRICT IMMUTABILITY: original clinical record cannot be edited
      allow delete: if false; // Retention requirement: clinical records cannot be deleted (CFP 01/2009)

      // SUBCOLLECTION DE RETIFICAÇÕES AUDITADAS
      // Cada retificação é gravada como adendo separado e imutável pelo psicólogo titular.
      match /retifications/{retificationId} {
        allow get, list: if isPsychologist() &&
          get(/databases/$(database)/documents/clinical_records/$(recordId)).data.psychologistId == request.auth.uid;
        allow create: if isPsychologist() &&
          get(/databases/$(database)/documents/clinical_records/$(recordId)).data.psychologistId == request.auth.uid &&
          request.resource.data.psychologistId == request.auth.uid &&
          request.resource.data.recordId == recordId &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.reason is string && request.resource.data.reason.size() > 0 &&
          request.resource.data.content is string && request.resource.data.content.size() > 0;
        allow update, delete: if false; // Adendos são estritamente imutáveis
      }
    }

    // FINANCIAL: PAYMENTS & EXPENSES
    match /payments/{paymentId} {
      allow get, list: if isSignedIn() && isActiveUser() && (
        (isPsychologist() && resource.data.psychologistId == request.auth.uid) ||
        (isPatient() && resource.data.patientUserId == request.auth.uid)
      );
      allow create: if isPsychologist() &&
        request.resource.data.psychologistId == request.auth.uid &&
        request.resource.data.id == paymentId &&
        exists(/databases/$(database)/documents/patients/$(request.resource.data.patientId)) &&
        get(/databases/$(database)/documents/patients/$(request.resource.data.patientId)).data.psychologistId == request.auth.uid;
      allow update: if isPsychologist() && resource.data.psychologistId == request.auth.uid &&
        request.resource.data.psychologistId == resource.data.psychologistId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.patientId == resource.data.patientId &&
        (!('clinicId' in resource.data) || request.resource.data.clinicId == resource.data.clinicId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'method', 'description', 'updatedAt']);
      allow delete: if isSuperAdmin();
    }

    match /expenses/{expenseId} {
      allow get, list: if isSignedIn() && isActiveUser() && (
        (isPsychologist() && resource.data.psychologistId == request.auth.uid) ||
        (isClinicManager() && exists(/databases/$(database)/documents/clinics/$(resource.data.clinicId)) && get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid)
      );
      allow create: if isSignedIn() && isActiveUser() && (
        (isPsychologist() && request.resource.data.psychologistId == request.auth.uid) ||
        (isClinicManager() && exists(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)) && get(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)).data.ownerId == request.auth.uid)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        (resource.data.psychologistId == request.auth.uid && request.resource.data.psychologistId == resource.data.psychologistId) ||
        (exists(/databases/$(database)/documents/clinics/$(resource.data.clinicId)) && get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid)
      ) &&
      request.resource.data.id == resource.data.id &&
      request.resource.data.amount == resource.data.amount &&
      (!('clinicId' in resource.data) || request.resource.data.clinicId == resource.data.clinicId) &&
      (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'date', 'status', 'paymentMethod', 'notes', 'updatedAt']);
      allow delete: if isSuperAdmin() || (resource.data.psychologistId == request.auth.uid);
    }

    // SUBSCRIPTIONS & PLANS (Multi-tenant SaaS isolation)
    match /subscriptions/{subId} {
      allow get, list: if isSignedIn() && isActiveUser() && (
        resource.data.targetId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (('clinicId' in resource.data) && exists(/databases/$(database)/documents/clinics/$(resource.data.clinicId)) && get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid) ||
        isSuperAdmin()
      );
      allow create, update, delete: if isSuperAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{notifId} {
      allow get, list: if isSignedIn() && isActiveUser() && resource.data.recipientUserId == request.auth.uid;
      allow create: if isSignedIn() && isActiveUser() &&
        request.resource.data.recipientUserId is string &&
        request.resource.data.recipientUserId.size() > 0 &&
        request.resource.data.senderId is string &&
        request.resource.data.senderId.size() > 0 &&
        request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && isActiveUser() &&
        resource.data.recipientUserId == request.auth.uid &&
        request.resource.data.recipientUserId == resource.data.recipientUserId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isSignedIn() && isActiveUser() && resource.data.recipientUserId == request.auth.uid;
    }

    // AUDIT LOGS
    // Append-only with strictly validated schema, read-only for superadministrators, never updatable or deletable
    match /audit_logs/{logId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSignedIn() && isActiveUser() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.id == logId &&
        (request.resource.data.action in ['read_clinical_record', 'create_clinical_record', 'update_clinical_record', 'cancel_appointment', 'role_change', 'approve_professional', 'reject_professional']) &&
        (request.resource.data.eventCode in ['CLINICAL_RECORD_VIEWED', 'CLINICAL_RECORD_CREATED', 'CLINICAL_RECORD_RECTIFIED', 'APPOINTMENT_CANCELLED', 'USER_ROLE_CHANGED', 'PROFESSIONAL_VERIFIED', 'PROFESSIONAL_REJECTED']) &&
        (request.resource.data.targetCollection in ['clinical_records', 'appointments', 'users', 'patients', 'professionals_public', 'professionals']) &&
        request.resource.data.targetId is string && request.resource.data.targetId.size() <= 128 &&
        request.resource.data.details is string && request.resource.data.details.size() <= 300 &&
        request.resource.data.timestamp is string;
      allow update: if false; // Immutable
      allow delete: if false; // Immutable
    }
  }
}
